#!/usr/bin/env bash

# Render portable agent guidance into each supported tool's instruction format.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_dir="$repo_root/agent-rules"
rule_names=(coding git python worktree)

for rule in "${rule_names[@]}"; do
    test -f "$source_dir/$rule.md"
done

render_combined() {
    local destination="$1"
    local title="$2"

    mkdir -p "$(dirname "$destination")"
    {
        printf '%s\n' "<!-- Generated by scripts/render-agent-rules; edit agent-rules/ instead. -->"
        printf '# %s\n' "$title"
        for rule in "${rule_names[@]}"; do
            printf '\n'
            cat "$source_dir/$rule.md"
        done
    } > "$destination"
}

claude_rules_dir="$repo_root/.claude/rules"
mkdir -p "$claude_rules_dir"
for rule in "${rule_names[@]}"; do
    {
        printf '%s\n\n' '<!-- Generated by scripts/render-agent-rules; edit agent-rules/ instead. -->'
        cat "$source_dir/$rule.md"
    } > "$claude_rules_dir/$rule.md"
done

render_combined "$repo_root/.codex/AGENTS.md" 'Global agent guidance'
render_combined "$repo_root/.copilot/copilot-instructions.md" 'Global agent guidance'
